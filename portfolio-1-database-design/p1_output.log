                                     Table "public.booking"
     Column     |           Type           | Collation | Nullable |           Default            
----------------+--------------------------+-----------+----------+------------------------------
 booking_id     | bigint                   |           | not null | generated always as identity
 pitch_id       | bigint                   |           | not null | 
 team_id        | bigint                   |           | not null | 
 start_time     | timestamp with time zone |           | not null | 
 duration_hours | integer                  |           | not null | 
 time_range     | tstzrange                |           |          | 
 status         | text                     |           | not null | 'confirmed'::text
 created_at     | timestamp with time zone |           | not null | now()
Indexes:
    "booking_pkey" PRIMARY KEY, btree (booking_id)
    "booking_no_overlap" EXCLUDE USING gist (pitch_id WITH =, time_range WITH &&) WHERE (status = 'confirmed'::text)
    "booking_pitch_start_idx" btree (pitch_id, start_time)
    "booking_status_idx" btree (status)
    "booking_team_idx" btree (team_id)
Check constraints:
    "booking_hourly_start_chk" CHECK (EXTRACT(minute FROM start_time) = 0::numeric AND EXTRACT(second FROM start_time) = 0::numeric AND duration_hours >= 1 AND duration_hours <= 3)
    "booking_opening_hours_chk" CHECK ((start_time AT TIME ZONE 'Africa/Lagos'::text)::time without time zone >= '07:00:00'::time without time zone AND ((start_time AT TIME ZONE 'Africa/Lagos'::text) + duration_hours::double precision * '01:00:00'::interval) <= (date_trunc('day'::text, (start_time AT TIME ZONE 'Africa/Lagos'::text)) + '23:00:00'::interval))
    "booking_status_check" CHECK (status = ANY (ARRAY['confirmed'::text, 'cancelled'::text, 'completed'::text, 'no_show'::text]))
    "booking_status_chk" CHECK (status <> 'cancelled'::text OR true)
Foreign-key constraints:
    "booking_pitch_id_fkey" FOREIGN KEY (pitch_id) REFERENCES pitch(pitch_id) ON DELETE RESTRICT
    "booking_team_id_fkey" FOREIGN KEY (team_id) REFERENCES team(team_id) ON DELETE RESTRICT
Referenced by:
    TABLE "match_result" CONSTRAINT "match_result_booking_id_fkey" FOREIGN KEY (booking_id) REFERENCES booking(booking_id) ON DELETE CASCADE
    TABLE "payment" CONSTRAINT "payment_booking_id_fkey" FOREIGN KEY (booking_id) REFERENCES booking(booking_id) ON DELETE CASCADE
Triggers:
    trg_check_team_size BEFORE INSERT OR UPDATE OF team_id ON booking FOR EACH ROW EXECUTE FUNCTION check_team_size()
    trg_sync_booking_time_range BEFORE INSERT OR UPDATE OF start_time, duration_hours ON booking FOR EACH ROW EXECUTE FUNCTION sync_booking_time_range()

                                   Table "public.payment"
   Column   |           Type           | Collation | Nullable |           Default            
------------+--------------------------+-----------+----------+------------------------------
 payment_id | bigint                   |           | not null | generated always as identity
 booking_id | bigint                   |           | not null | 
 amount     | numeric(12,2)            |           | not null | 
 currency   | text                     |           | not null | 'NGN'::text
 method     | text                     |           | not null | 
 status     | text                     |           | not null | 'pending'::text
 paid_at    | timestamp with time zone |           | not null | now()
Indexes:
    "payment_pkey" PRIMARY KEY, btree (payment_id)
    "payment_booking_idx" btree (booking_id)
    "payment_paid_at_idx" btree (paid_at)
    "payment_status_idx" btree (status)
Check constraints:
    "payment_amount_max_chk" CHECK (amount <= 1000000::numeric)
    "payment_amount_positive_chk" CHECK (amount > 0::numeric)
    "payment_method_check" CHECK (method = ANY (ARRAY['card'::text, 'transfer'::text, 'wallet'::text, 'cash'::text]))
    "payment_status_check" CHECK (status = ANY (ARRAY['pending'::text, 'succeeded'::text, 'failed'::text, 'refunded'::text]))
Foreign-key constraints:
    "payment_booking_id_fkey" FOREIGN KEY (booking_id) REFERENCES booking(booking_id) ON DELETE CASCADE

